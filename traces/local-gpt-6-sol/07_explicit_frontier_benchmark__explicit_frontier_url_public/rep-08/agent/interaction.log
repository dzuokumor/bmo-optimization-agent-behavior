{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import minimize\nfor n in [20,40,80]:\n eps2=1/12\n # interval constraints all contiguous bins weighted equally\n pairs=[]\n for i in range(n):\n  for j in range(i+1,n+1):\n   pairs.append((i,j))\n def obj(x):\n  f=-10+x\n  return -np.mean(f**3+np.abs(f))\n cons=[{'type':'eq','fun':lambda x: np.mean(x)}, {'type':'eq','fun':lambda x: np.mean(x*x)-eps2}]\n for i,j in pairs:\n  cons.append({'type':'ineq','fun':lambda x,i=i,j=j: eps2 - (np.mean(x[i:j]**2)-np.mean(x[i:j])**2)})\n best=None\n for k in range(10):\n  x=np.random.randn(n); x-=x.mean(); x*=np.sqrt(eps2/np.mean(x*x))\n  rr=minimize(obj,x,method='SLSQP',constraints=cons,options={'maxiter':1000,'ftol':1e-12,'disp':False})\n  if rr.success and (best is None or rr.fun<best.fun):best=rr\n print(n,best.fun if best else None, -best.fun-(-1985/2) if best else None)\n if best: print(np.round(best.x,3))\nPY\npython /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
