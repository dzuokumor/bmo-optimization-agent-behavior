{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import minimize\n\ndef solve(n,tries=20):\n    # cells equal; interval constraints contiguous full cells only (weaker)\n    w=1/n\n    pairs=[(i,j) for i in range(n) for j in range(i+1,n+1)]\n    def obj(x): return -np.mean(x**3)\n    cons=[]\n    cons += [{'type':'eq','fun':lambda x:np.mean(x)}, {'type':'eq','fun':lambda x:np.mean(x*x)-1}]\n    for i,j in pairs:\n      cons.append({'type':'ineq','fun':lambda x,i=i,j=j: 1 - (np.mean(x[i:j]**2)-np.mean(x[i:j])**2)})\n    best=None\n    for z in range(tries):\n      x=np.random.randn(n); x-=x.mean(); x/=np.sqrt(np.mean(x*x))\n      rr=minimize(obj,x,constraints=cons,method='SLSQP',options={'maxiter':2000,'ftol':1e-11})\n      if rr.success and (best is None or rr.fun<best.fun):best=rr\n    print(n,best and -best.fun,best and np.round(best.x,3))\nfor n in [4,6,8,10,15,20]: solve(n,10)\nPY\npython /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
