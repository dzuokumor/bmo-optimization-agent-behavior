{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"cat > /tmp/check.py <<'PY'\nimport math\n\ndef ih(x):return 0 if x<=0 else -x*math.log(x)\ndef ih2(x):return 0 if x<=0 else x*(math.log(x)**2+1)\ndef calc(p,a,b):\n # domain high [0,p], x=t/p, low const bval, J [a,b]\n mu=(1-p)/math.sqrt(p); low=-math.sqrt(p)\n # high integrals over t; h=-ln(t/p)-1\n lhi=max(0,min(b,p)-a) if a<p else 0\n # only support if a<p\n if a<p:\n  hi_end=min(b,p); x0=a/p; x1=hi_end/p\n  I1= p*(ih(x1)-ih(x0)); I2=p*(ih2(x1)-ih2(x0))\n  s1=mu*lhi+I1; s2=mu*mu*lhi+2*mu*I1+I2\n else:s1=s2=0\n lowstart=max(a,p); lowlen=max(0,b-lowstart); s1+=lowlen*low;s2+=lowlen*low*low\n L=b-a;m=s1/L;return s2/L-m*m\nfor p in [1/9,.12,.2,.5]:\n mx=(0,0,0)\n N=400\n for i in range(N):\n  a=p*i/N\n  for j in range(int((1-a)*N/(1))):\n   b=a+(1-a)*(j+1)/N\n   v=calc(p,a,b)\n   if v>mx[2]:mx=(a,b,v)\n print('p',p,'max',mx,'root',calc(p,0,1))\nPY\npython3 /tmp/check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
