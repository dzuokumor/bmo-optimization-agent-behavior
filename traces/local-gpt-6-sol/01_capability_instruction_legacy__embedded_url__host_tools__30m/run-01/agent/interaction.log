{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nimport math,random\nfor L in [1,2,3,5,10]:\n d=math.exp(-L)\n def mom(a,b):\n  # integrate x=min(-ln t,L) moments over uniform [a,b]\n  # antideriv int (-ln t)\"'^k dt\n  def F(t,k):\n   if k==0:return t\n   if k==1:return t*(-math.log(t)+1)\n   if k==2:return t*((-math.log(t))**2+2*(-math.log(t))+2)\n  def intseg(lo,hi,k):\n   if hi<=d:return (hi-lo)*L**k\n   if lo>=d:return F(hi,k)-F(lo,k)\n   return (d-lo)*L**k+F(hi,k)-F(d,k)\n  mm=[intseg(a,b,k)/(b-a) for k in range(3)]\n  return mm[2]-mm[1]**2\n V=(2-2*d)-(1-d)**2\n mx=(0,None)\n for i in range(100000):\n  a=random.random(); b=a+(1-a)*random.random()\n  v=mom(a,b)\n  if v>mx[0]:mx=(v,(a,b))\n print(L,'\"'global',V,'mx',mx)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
