{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import minimize\nfor n in [10,20,30,50]:\n  # variables h; constraints mean 0, mean sq1; interval variance <=1\n  def obj(x): return -np.mean(x**3)\n  cons=[{'type':'eq','fun':lambda x: np.mean(x)}, {'type':'eq','fun':lambda x: np.mean(x*x)-1}]\n  # interval blocks approximate\n  for i in range(n):\n    for j in range(i+1,n+1):\n      if j-i>=2:\n       cons.append({'type':'ineq','fun':lambda x,i=i,j=j: 1-np.mean((x[i:j]-np.mean(x[i:j]))**2)})\n  best=None\n  for k in range(10):\n    x=np.random.randn(n); x-=x.mean(); x/=np.sqrt(np.mean(x*x))\n    r=minimize(obj,x,method='SLSQP',constraints=cons,options={'maxiter':1000,'ftol':1e-10})\n    if r.success and (best is None or r.fun<best.fun):best=r\n  print(n,best and -best.fun,best and np.round(best.x,3))\nPY\npython /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
