{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat >/tmp/opt.py <<'PY'\nimport random,math\n\ndef norm(x):\n n=len(x); m=sum(x)/n; x=[v-m for v in x]; s=math.sqrt(sum(v*v for v in x)/n*12); return [v/s for v in x]\ndef maxv(x):\n n=len(x); mx=0; arg=None\n for i in range(n):\n  ss=0;ss2=0\n  for j in range(i,n):\n   ss+=x[j];ss2+=x[j]*x[j]; L=j-i+1\n   v=ss2/L-(ss/L)**2\n   if v>mx:mx=v;arg=(i,j)\n return mx,arg\ndef obj(x): return sum(v**3 for v in x)/len(x)\ndef valid(x): return maxv(x)[0] <= 1/12+1e-9\nfor n in [8,10,12,16,20]:\n best=(-1,None,None)\n for restart in range(300):\n  x=norm([random.gauss(0,1) for _ in range(n)])\n  # simulated anneal with penalty\n  score=lambda z: obj(z)-100*max(0,maxv(z)[0]-1/12)**2*100\n  sc=score(x)\n  for it in range(3000):\n   temp=.03*(1-it/3000)+1e-4\n   y=x[:]\n   k=random.randrange(n); y[k]+=random.gauss(0,.1*temp/.03)\n   y=norm(y)\n   sy=score(y)\n   if sy>sc or random.random()<math.exp((sy-sc)/temp):x,sc=y,sy\n  mv,arg=maxv(x)\n  if mv<=1/12+1e-5 and obj(x)>best[0]: best=(obj(x),x,mv)\n print('n',n,'best',best[0],'mv',best[2], 'x', [round(v,3) for v in best[1]] if best[1] else None)\nPY\npython3 /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
