{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math\nfor p in [1/9,.2,.5]:\n A=(1-p)/math.sqrt(p)-1;b=-math.sqrt(p)\n for n in [10000]:\n  # integrate sample midpoint; spike at [0,p]\n  x=[]\n  for i in range(n):\n   t=(i+.5)/n\n   x.append(A-math.log(t/p) if t<p else b)\n  # sample intervals boundaries around p; brute selected intervals\n  mx=(0,None)\n  for i in range(0,n, max(1,n//1000)):\n   s=0\n   for j in range(i,n):\n    s+=x[j]; l=j-i+1; a=s/l\n    # incremental sq via sumsq\n    # inefficient\n    if j-i<5 or j in [n-1,int(p*n),int(p*n)+1]:\n     vv=sum((x[k]-a)**2 for k in range(i,j+1))/l\n     if vv>mx[0]:mx=(vv,(i,j))\n  print('p',p,'A,b',A,b,'mx sample',mx)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math\nfor p in [1/9,.2,.5]:\n A=(1-p)/math.sqrt(p)-1;b=-math.sqrt(p)\n for n in [10000]:\n  # integrate sample midpoint; spike at [0,p]\n  x=[]\n  for i in range(n):\n   t=(i+.5)/n\n   x.append(A-math.log(t/p) if t<p else b)\n  # sample intervals boundaries around p; brute selected intervals\n  mx=(0,None)\n  for i in range(0,n, max(1,n//1000)):\n   s=0\n   for j in range(i,n):\n    s+=x[j]; l=j-i+1; a=s/l\n    # incremental sq via sumsq\n    # inefficient\n    if j-i<5 or j in [n-1,int(p*n),int(p*n)+1]:\n     vv=sum((x[k]-a)**2 for k in range(i,j+1))/l\n     if vv>mx[0]:mx=(vv,(i,j))\n  print('p',p,'A,b',A,b,'mx sample',mx)\nPY\"","aggregated_output":"p 0.1111111111111111 A,b 1.6666666666666665 -0.3333333333333333 mx sample (1.0092388884903432, (0, 1112))\np 0.2 A,b 0.7888543819998319 -0.4472135954999579 mx sample (1.0009484601940182, (0, 2001))\np 0.5 A,b -0.29289321881345254 -0.7071067811865476 mx sample (0.9992785186955853, (0, 9999))\n","exit_code":0,"status":"completed"}}
