{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math\nfor n in [20,100,1000]:\n x=[-math.log((i+.5)/n)-1 for i in range(n)]; m=sum(x)/n;x=[v-m for v in x]; var=sum(v*v for v in x)/n;x=[v/math.sqrt(var) for v in x]\n mx=0;arg=None\n for i in range(n):\n  s=0\n  for j in range(i,n):\n   s+=x[j];l=j-i+1;a=s/l;vv=sum((x[k]-a)**2 for k in range(i,j+1))/l\n   if vv>mx:mx=vv;arg=(i,j)\n print(n,var,sum(v**3 for v in x)/n,mx,arg)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
