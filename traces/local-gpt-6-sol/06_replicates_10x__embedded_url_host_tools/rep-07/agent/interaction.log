{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import minimize\nfor n in [20,40]:\n    sig=1/np.sqrt(12); dt=1/n\n    # variables q n values; objective maximize\n    t=(np.arange(n)+.5)/n\n    q0=sig*(np.log(1/t)-1)\n    def obj(q):\n      return -np.mean(q**3+2*np.maximum(q-10,0))\n    cons=[{'type':'eq','fun':lambda q: np.mean(q)}, {'type':'eq','fun':lambda q: np.mean(q*q)-sig**2}]\n    # monotonic q descending\n    for i in range(n-1): cons.append({'type':'ineq','fun':lambda q,i=i:q[i]-q[i+1]})\n    # all intervals variance <= sig2\n    for i in range(n):\n      for j in range(i+1,n+1):\n        cons.append({'type':'ineq','fun':lambda q,i=i,j=j: sig**2 - (np.mean(q[i:j]**2)-np.mean(q[i:j])**2)})\n    res=minimize(obj,q0,constraints=cons,method='SLSQP',options={'maxiter':500,'ftol':1e-11,'disp':False})\n    print(n,res.success,res.fun, -res.fun, res.message)\n    print(res.x[:5],res.x[-5:], 'third',np.mean(res.x**3),'tail',2*np.mean(np.maximum(res.x-10,0)))\nPY\npython /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
