{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport random,math\n\ndef evalv(a):\n n=len(a); mu=sum(a)/n\n # normalize mean0 var eps2\n m2=sum(x*x for x in a)/n\n if m2==0:return None\n s=math.sqrt((1/12)/m2)\n a=[(x-mu)*s for x in a]\n # interval cell aligned max variance; and adjacent jump variance max <=1/12\n mx=0\n for i in range(n):\n  sm=ss=0\n  for j in range(i,n):\n   sm+=a[j];ss+=a[j]*a[j]; l=j-i+1\n   v=ss/l-(sm/l)**2\n   if v>mx:mx=v\n # for piecewise steps arbitrary crossing each boundary max jump²/4\n for x,y in zip(a,a[1:]): mx=max(mx,(x-y)**2/4)\n if mx>1/12+1e-9:return -1e9,mx,a\n # objective shifted exact assuming | |\n obj=sum(x**3 for x in a)/n +2*sum(max(x-10,0) for x in a)/n\n return obj,mx,a\nfor n in [4,8,16,32]:\n best=(-1e9,None)\n for restart in range(100):\n  a=[random.gauss(0,1) for _ in range(n)]\n  z=evalv(a)\n  if z[0]<-1e8:continue\n  cur=z\n  for it in range(20000):\n   b=cur[2][:]\n   i=random.randrange(n);b[i]+=random.gauss(0,.2)\n   zz=evalv(b)\n   if zz[0]>cur[0] or random.random()<math.exp((zz[0]-cur[0])*1000):cur=zz\n   if cur[0]>best[0]:best=(cur[0],cur)\n print(n,best[0],best[1][1],best[1][2])\nPY\npython3 /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
