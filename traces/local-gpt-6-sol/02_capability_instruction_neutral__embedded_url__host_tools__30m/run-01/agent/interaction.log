{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/search.py <<'PY'\nimport math, random\n\ndef stats(a):\n n=len(a)\n m=sum(a)/n\n a=[x-m for x in a]\n v=sum(x*x for x in a)/n\n # max interval variance\n maxv=0; arg=None\n for i in range(n):\n  s=0; ss=0\n  for j in range(i,n):\n   s+=a[j]; ss+=a[j]*a[j]\n   l=j-i+1\n   vv=ss/l-(s/l)**2\n   if vv>maxv: maxv=vv;arg=(i,j)\n return v,maxv,arg,a\n\ndef obj(a,A=10):\n n=len(a)\n return sum(x**3+2*max(x-A,0) for x in a)/n\nfor N in [16,32,64,128]:\n # log samples at cell midpoints\n a=[-math.log((i+.5)/N)-1 for i in range(N)]\n v,mx,arg,a=stats(a); sc=1/math.sqrt(v)\n a=[x*sc for x in a]\n print('N',N,'v/mx',v/mx,'obj',obj(a),'cubic',sum(x**3 for x in a)/N,'arg',arg)\n # normalization by max and see global\n # random monotone perturbations around log preserving monotonic\n best=-1e9; besta=None\n base=a\n for k in range(30000):\n  b=[]\n  # random noise cumulative smooth\n  for x in base:\n   b.append(x + random.gauss(0, 0.1*(1+abs(x)/5)))\n  b.sort(reverse=True)\n  v,mx,arg,b=stats(b)\n  if mx <= v*(1+1e-10):\n   sc=1/math.sqrt(v); bb=[x*sc for x in b]\n   z=obj(bb)\n   if z>best:best=z;besta=(bb,v,mx,arg)\n print('best',best,'gap',best-obj(base),'arg',besta[3] if besta else None)\nPY\npython3 /tmp/search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
