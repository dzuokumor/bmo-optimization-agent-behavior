{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/pert.py <<'PY'\nimport math\n\ndef make(N,A,eps,w=0.2):\n # cell midpoints x. r=1 + u: negative before x0, positive after; intervals in log x around x0\n x0=math.exp(-(A+1)); rs=[]\n for i in range(N):\n  x=(i+.5)/N\n  u=0\n  if x0*math.exp(-w)<x<x0: u=-eps\n  if x0<x<x0*math.exp(w): u=eps\n  rs.append(1+u)\n # adjust positive amplitude to make integral r\"'^2=1 approximately, then derive m backwards\n # binary scale positive\n neg=[(x0*math.exp(-w)<(i+.5)/N<x0) for i in range(N)]\n pos=[(x0<(i+.5)/N<x0*math.exp(w)) for i in range(N)]\n sn=sum(1 for z in neg if z)/N; sp=sum(1 for z in pos if z)/N\n rp=((1-(sn*(1-eps)**2+(1-sn-sp)*1))/sp)**.5 if sp else 1\n for i in range(N):\n  if pos[i]:rs[i]=rp\n # m(x)=int_x''^1 r/s ds approximate cell integral, use midpoint sums\n m=[]; accum=0\n for i in range(N-1,-1,-1):\n  x=(i+.5)/N; accum += rs[i]/x/N; m.append(accum)\n m=m[::-1]\n g=[m[i]-rs[i] for i in range(N)]\n # center/scale moments (approx)\n mean=sum(g)/N;g=[z-mean for z in g];v=sum(z*z for z in g)/N;g=[z/math.sqrt(v) for z in g]\n # bmo max\n mx=0;arg=None\n for i in range(N):\n  s=ss=0\n  for j in range(i,N):\n   s+=g[j];ss+=g[j]*g[j];l=j-i+1;vv=ss/l-(s/l)**2\n   if vv>mx:mx=vv;arg=(i,j)\n obj=sum(z**3+2*max(z-A,0) for z in g)/N\n return obj,mx,arg,g\nfor A in [1,2,5]:\n N=500\n # log baseline\n o,m,a,g=make(N,A,0)\n print('\"'A',A,'base',o,m,a)\n for eps in [.001,.01,.05,.1]:\n  o,m,a,g=make(N,A,eps)\n  print(eps,o,m,a)\nPY\npython3 /tmp/pert.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
