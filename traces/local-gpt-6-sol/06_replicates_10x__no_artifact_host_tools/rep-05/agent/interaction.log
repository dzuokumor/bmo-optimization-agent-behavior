{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport math, random\ns=1/3; d=s*s; C=(1-d)/s; D=-s\n# integrate h and h2 over arbitrary [a,b]\ndef ints(a,b):\n # h in log block if t<d: -ln(t/d)-1+C = -ln t + ln d -1+C\n I1=I2=0\n if a<d:\n  z=min(b,d); u=a/d; v=z/d\n  # integral over x u..v y=-ln x -1 + C; primitive y int=-x ln x\n  def P1(x): return -x*math.log(x) if x>0 else 0\n  def P2(x):\n   L=-math.log(x) if x>0 else 1e99\n   # integral y0\"'^2 antiderivative? use F(x)=x*((-lnx-1)''^2+1) from 0 to x\n   return x*((-math.log(x)-1)**2+1) if x>0 else 0\n  i1=P1(v)-P1(u)+C*(v-u)\n  # int y0''^2: F(v)-F(u)\n  i2=P2(v)-P2(u)+2*C*(P1(v)-P1(u))+C*C*(v-u)\n  I1+=d*i1; I2+=d*i2\n if b>d:\n  aa=max(a,d); I1+=(b-aa)*D; I2+=(b-aa)*D*D\n return I1,I2\nmx=(0,None)\nfor _ in range(500000):\n a=random.random(); b=a+(1-a)*random.random()\n I1,I2=ints(a,b); m=I1/(b-a); v=I2/(b-a)-m*m\n if v>mx[0]:mx=(v,(a,b,m))\nprint(mx)\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
