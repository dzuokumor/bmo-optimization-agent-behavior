{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport random,math\n\ndef eval(x):\n n=len(x);m=sum(x)/n;x=[a-m for a in x];v=sum(a*a for a in x)/n\n mx=0\n for i in range(n):\n  s=ss=0\n  for j in range(i,n):\n   s+=x[j];ss+=x[j]*x[j];l=j-i+1\n   if l>=2:\n    q=ss/l-(s/l)**2\n    if q>mx:mx=q\n return sum(a**3 for a in x)/n/v**1.5,mx/v,x\nfor n in [12,20,30]:\n # start random sorted passing\n best=(-99,None)\n for restart in range(30):\n  x=[random.gauss(0,1) for _ in range(n)]\n  x.sort()\n  q,r,_=eval(x)\n  # anneal with monotonic via increments logs\n  inc=[math.exp(random.uniform(-2,2)) for _ in range(n-1)]\n  for it in range(30000):\n   k=random.randrange(n-1); old=inc[k]; inc[k]*=math.exp(random.gauss(0,.15))\n   y=[0]\n   for d in inc:y.append(y[-1]+d)\n   qq,rr,zz=eval(y)\n   # only accept rr <= 1 approximately, objective maximize; penalty\n   score=qq-100*max(0,rr-1)**2\n   oldscore=q-100*max(0,r-1)**2\n   temp=.05*(1-it/30000)+.0001\n   if score>oldscore or random.random()<math.exp((score-oldscore)/temp):q,r=qq,rr\n   else:inc[k]=old\n   if r<=1.000001 and q>best[0]:\n    best=(q,zz[:])\n print('n',n,'best',best[0], 'ratio',eval(best[1])[1], 'x', [round(z,2) for z in best[1]])\nPY\npython3 /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
