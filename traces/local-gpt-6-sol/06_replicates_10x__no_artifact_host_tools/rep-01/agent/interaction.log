{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/search.py <<'PY'\nimport random, math\nN=200\n# piecewise linear eval; use grid intervals sample approximate variance\n\ndef evalf(par,t):\n a,b,c,r=par\n return a+b*t+c*max(0,t-r)\ndef stats(par,M=400):\n vals=[evalf(par,(i+.5)/M) for i in range(M)]\n m=sum(vals)/M; v=sum((x-m)**2 for x in vals)/M\n return m,v\n\ndef maxloc(par,M=300,step=2):\n # intervals on grid, all lengths >= step points\n vals=[evalf(par,(i+.5)/M) for i in range(M)]\n s=[0]; q=[0]\n for x in vals:s.append(s[-1]+x);q.append(q[-1]+x*x)\n mx=0; arg=None\n for i in range(M):\n  for j in range(i+step,M+1,step):\n   n=j-i;m=(s[j]-s[i])/n;v=(q[j]-q[i])/n-m*m\n   if v>mx:mx=v;arg=(i/M,j/M)\n return mx,arg\nbest=(-1,None)\nfor k in range(200000):\n r=random.random()\n b=random.uniform(-5,5); c=random.uniform(-10,10)\n # choose a to mean 0 analytically mean max term c*(1-r)**2/2 + b/2 +a\n a= -b/2 - c*(1-r)**2/2\n par=(a,b,c,r)\n m,v=stats(par,300)\n if v<1e-8:continue\n scale=math.sqrt((1/12)/v)\n par=tuple(x*scale for x in par[:3])+(r,)\n m,v=stats(par,500)\n ml,arg=maxloc(par,120,2)\n if ml<=1/12*1.002:\n  # third\n  vals=[evalf(par,(i+.5)/1000) for i in range(1000)]\n  th=sum(x**3 for x in vals)/1000\n  if th>best[0]:best=(th,(par,ml,arg))\nprint(best)\nPY\npython3 /tmp/search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
