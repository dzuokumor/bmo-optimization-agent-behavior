{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat >/tmp/stair.py <<'PY'\nimport math,random\n\ndef calc(q,N=150):\n p=1-q\n # normalized domain bins descending values k, intervals (q\"'^(k+1),q''^k), tail cutoff N assigned geometric moments approx\n # moments integral on [a,b] function bins, use exact tail sums beyond N if a=0\n def ints(a,b):\n  L=b-a;s1=s2=s3=0.\n  for k in range(N):\n   l=q**(k+1);r=q**k\n   ll=max(a,l);rr=min(b,r)\n   if rr>ll:\n    s1+=(rr-ll)*k;s2+=(rr-ll)*k*k;s3+=(rr-ll)*k**3\n  if a<q**N:\n   # tail [0,q''^N], conditional geometric k=N+G; moments G with probs p q''^g\n   ll=max(a,0);rr=min(b,q**N)\n   if rr>ll:\n    w=rr-ll\n    # assign exact conditional moments approximate full tail, but if a>0 bad; b endpoints mostly\n    # just assign N for partial\n    if a>0:\n     s1+=w*N;s2+=w*N*N;s3+=w*N**3\n    else:\n     # tail moments weighted q''^N: E k conditional =N+q/p, E k2 etc\n     eg=q/p; eg2=q*(1+q)/p**2; eg3=q*(1+4*q+q*q)/p**3\n     s1+=w*(N+eg); s2+=w*(N*N+2*N*eg+eg2);s3+=w*(N**3+3*N*N*eg+3*N*eg2+eg3)\n  return s1,s2,s3\n # sample endpoint b values within bins; intervals [a,b] perhaps prefix only\n M=0;arg=None\n bs=[q**k for k in range(N+1)]+[q**(k+1)+(q**k-q**(k+1))*z for k in range(N) for z in [.01,.1,.25,.5,.75,.9,.99]]\n for b in bs:\n  s1,s2,s3=ints(0,b);m=s1/b;v=s2/b-m*m\n  if v>M:M=v;arg=b\n # also arbitrary intervals random likely not exceed\n # global moments exact\n V=q/p**2; C=q*(1+q)/p**3 -3*(q/p**2)*(q/p) # central third of geom K\n # actually central third = q*(1+q)/p**3? cumulant3 = q(1+q)/p''^3\n C=q*(1+q)/p**3\n scale=1/math.sqrt(M)\n # standardized by local BMO norm; global var ratio V/M; third ratio C/M''^1.5\n K=C/M**1.5\n return M,V,C,K,scale,arg\nfor q in [.9,.8,.7,.6,.5,.4,.3,.25,.2,.17,.1,.05]:\n M,V,C,K,sc,arg=calc(q)\n print(q,'\"'M',M,'V/M',V/M,'K',K,'delta_std',sc,'arglog',-math.log(arg))\nPY\npython3 /tmp/stair.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
