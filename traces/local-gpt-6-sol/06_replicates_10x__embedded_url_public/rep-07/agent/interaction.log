{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/opt.py <<'PY'\nimport numpy as np\nfrom scipy.optimize import minimize\nfor n in [20,40]:\n  inds=[(i,j) for i in range(n) for j in range(i+1,n+1)]\n  sig=1/12\n  def obj(x): return -np.mean(x**3)\n  cons=[{'type':'eq','fun':lambda x:np.mean(x)}, {'type':'eq','fun':lambda x:np.mean(x*x)-sig}]\n  for i,j in inds:\n    cons.append({'type':'ineq','fun':lambda x,i=i,j=j: sig - (np.mean(x[i:j]**2)-np.mean(x[i:j])**2)})\n  best=None\n  for k in range(10):\n   x=np.random.randn(n);x-=x.mean();x*=np.sqrt(sig/np.mean(x*x))\n   rr=minimize(obj,x,constraints=cons,method='SLSQP',options={'maxiter':2000,'ftol':1e-10})\n   if rr.success and (best is None or rr.fun<best.fun): best=rr\n  print(n,best.fun, np.round(best.x,3))\nPY\npython /tmp/opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
