{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/search.py <<'PY'\nimport math, random\n\ndef evalf(fun,N=500):\n vals=[fun((i+.5)/N) for i in range(N)]\n mu=sum(vals)/N; vals=[x-mu for x in vals]\n var=sum(x*x for x in vals)/N\n # max interval variance O(N\"'^2) using loops incremental\n mx=0\n for i in range(N):\n  s=s2=0\n  for j in range(i,N):\n   s+=vals[j];s2+=vals[j]*vals[j]; L=j-i+1\n   v=s2/L-(s/L)**2\n   if v>mx:mx=v\n k=1/math.sqrt(mx) # normalized BMO to 1\n m3=sum((k*x)**3 for x in vals)/N\n return var*k*k,m3,mx/var\nfor a in [0,.001,.01,.03,.1,.3,1,3]:\n f=lambda t,a=a: -math.log(t+a)\n print('\"'logshift',a,evalf(f,300))\n# mixtures\nfor q in [0,.1,.2,.3,.5,1,2,5,10]:\n f=lambda t,q=q: -math.log(t)+q*(t*t)\n try: print('mix',q,evalf(f,300))\n except: pass\nPY\npython3 /tmp/search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
