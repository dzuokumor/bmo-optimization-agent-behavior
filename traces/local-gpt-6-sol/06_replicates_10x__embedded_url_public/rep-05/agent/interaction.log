{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport random, math\n\ndef stats(a):\n n=len(a); pre=[0];pre2=[0];pre3=[0]\n for x in a:pre.append(pre[-1]+x);pre2.append(pre2[-1]+x*x);pre3.append(pre3[-1]+x*x*x)\n mean=pre[-1]/n; var=pre2[-1]/n-mean*mean; m3=pre3[-1]/n-3*mean*pre2[-1]/n+2*mean**3\n mx=0\n for i in range(n):\n  for j in range(i+1,n+1):\n   m=(pre[j]-pre[i])/(j-i); v=(pre2[j]-pre2[i])/(j-i)-m*m\n   mx=max(mx,v)\n return mean,var,m3,mx\nfor n in [8,12,20,30]:\n best=(-1,None)\n for k in range(300000):\n  # random walk/smooth + noise to meet condition\n  a=[random.gauss(0,1) for _ in range(n)]\n  mean,var,m3,mx=stats(a)\n  if var>1e-9 and mx<=var*(1+1e-9):\n   r=m3/(var**1.5)\n   if r>best[0]:best=(r,(a,mean,var,m3,mx))\n print(n,best[0])\n if best[1]: print(best[1][1:])\nPY\"","aggregated_output":"8 1.1713979276301127\n(0.008348400566237368, 1.56883620682218, 2.3018173381354914, 1.56883620682218)\n12 0.8058288096241006\n(-0.2291469213471434, 1.1123358523706475, 0.945358847815875, 1.1123358523706475)\n20 0.4139747480831914\n(-0.12191382432089522, 1.004195193579895, 0.41658253466282447, 1.004195193579895)\n30 -1\n","exit_code":0,"status":"completed"}}
