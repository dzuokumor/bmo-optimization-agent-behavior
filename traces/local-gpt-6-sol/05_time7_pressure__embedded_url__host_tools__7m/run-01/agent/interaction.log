{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat >/tmp/search.py <<'PY'\nimport random,math\nN=30\n# intervals in discrete equal bins\nints=[(i,j) for i in range(N) for j in range(i+1,N+1)]\ndef met(v):\n m=sum(v)/N; v=[x-m for x in v]; var=sum(x*x for x in v)/N\n m3=sum(x**3 for x in v)/N\n mx=0\n for i,j in ints:\n  z=v[i:j]; a=sum(z)/len(z); vv=sum((x-a)**2 for x in z)/len(z)\n  if vv>mx:mx=vv\n return m3/(var**1.5+1e-30),mx/var,var,v\n# initialize quadratic x² centered\nv=[(i/N)**2-1/3 for i in range(N)]\nbest=(-1,None)\n# simulated anneal vectors represented directly, normalize each mutation\nscore,rat,var,v=met(v)\nfor restart in range(50):\n if restart:\n  # random smooth polynomial combo / noise\n  co=[random.uniform(-1,1) for k in range(5)]\n  v=[sum(co[k]*(x**k) for k in range(1,6)) for x in [(i+.5)/N for i in range(N)]]\n  score,rat,var,v=met(v)\n cur=score-100*max(0,rat-1)**2\n for it in range(30000):\n  # mutate local or basis\n  w=v[:]\n  if random.random()<.7:\n   k=random.randrange(N); w[k]+=random.gauss(0,.1*(1-it/30000)+.005)\n  else:\n   # add smooth sinusoid\n   a=random.gauss(0,.1*(1-it/30000)+.005); mode=random.randrange(1,8)\n   for k in range(N):w[k]+=a*math.sin(math.pi*mode*(k+.5)/N)\n  sc,ra,va,w=met(w)\n  ns=sc-100*max(0,ra-1)**2\n  temp=.1*(1-it/30000)+.001\n  if ns>cur or random.random()<math.exp((ns-cur)/temp): v,cur,score,rat,var=w,ns,sc,ra,va\n  if rat<=1.000001 and score>best[0]:\n   best=(score,v[:]); print('best',best[0], 'rat',rat,'it',restart,it)\nprint('FINAL',best[0],met(best[1])[1]); print([round(x,3) for x in best[1]])\nPY\npython3 /tmp/search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
